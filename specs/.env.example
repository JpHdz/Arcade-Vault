# Arcade Vault — environment variables
#
# Copy this file to `.env.local` IN THE PROJECT ROOT and fill in the values.
# Next.js only loads `.env*` files from the project root, never from a
# subdirectory, so a copy left next to this file would be ignored.
#
# `.env.local` is git-ignored. This example file is committed on purpose and
# must never contain a real key.

# Resend API key, from https://resend.com/api-keys — starts with `re_`.
# Leave it unset in development to run the contact form in dry-run mode: the
# Server Action logs the message to the server console and reports success
# without sending anything. In production a missing key is an error instead.
RESEND_API_KEY=

# Mailbox that receives the messages sent from the contact form on /about.
CONTACT_TO_EMAIL=your-name@example.com

# Sender shown in those messages. The friendly-name format is supported.
# `onboarding@resend.dev` is Resend's shared testing sender: it works without
# verifying a domain, but delivery is limited and messages are likelier to be
# filtered as spam. For a real deployment, verify your own domain and use an
# address on it.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# Supabase project API URL, from the dashboard's Connect dialog or
# Settings > API. Public by design: it is inlined into the browser bundle at
# build time, so changing it requires a rebuild. Leave it unset to run without
# Supabase: the clients in `lib/supabase/` then return `null`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key, from Settings > API Keys — starts with
# `sb_publishable_`. Public by design, like the URL: security rests on Row
# Level Security, not on keeping this key secret. Do not use the legacy JWT
# `anon` key or the secret `sb_secret_` key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase database password. Read ONLY by the Supabase CLI (`supabase link`,
# `npm run db:push`), never by the app, and it must never gain a
# `NEXT_PUBLIC_` prefix. The CLI does not load `.env.local`: export it in your
# shell or type it at the CLI's prompt. It is listed here only as a reminder.
SUPABASE_DB_PASSWORD=